{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "city.config.schema.json",
  "title": "Health Pulse city configuration",
  "description": "One deployment = one city config. Paths under `data` are relative to the config/ directory. The `pipeline` block is read only by the Python data pipeline and is stripped before the config reaches the browser.",
  "type": "object",
  "required": ["id", "appName", "agency", "region", "brand", "theme", "map", "featuredZips", "dataQualityNotes", "serviceGuideUrl", "data", "dataSources", "dataAsOf", "pipeline"],
  "additionalProperties": false,
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "zip": { "type": "string", "pattern": "^\\d{5}$" },
    "relPath": { "type": "string", "pattern": "^data/[A-Za-z0-9._/-]+$" },
    "rem": { "type": "number", "minimum": 0.5, "maximum": 6 },
    "length": { "type": "string", "pattern": "^\\d+(\\.\\d+)?(rem|px)$" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Preset id; also the config/data/<id>/ directory name." },
    "appName": { "type": "string", "minLength": 1 },
    "agency": {
      "type": "object",
      "required": ["name", "shortName", "parent"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "parent": { "type": "string", "minLength": 1, "description": "Parent government, e.g. 'City of Austin'." }
      }
    },
    "region": {
      "type": "object",
      "required": ["name", "cityName", "state"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Name for the area the ZIP set covers, used as a proper noun in UI copy ('across X', 'the X average', 'X ZIPs'), e.g. 'Greater Austin' or 'Harris County'. It should describe the ZIP set accurately: the averages are taken across these ZIPs." },
        "cityName": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "showBuildStory": {
      "type": "boolean",
      "default": false,
      "description": "Show the 'How This Was Built' section in the About panel. It tells Austin Public Health's own build story, so other agencies should leave it off."
    },
    "brand": {
      "type": "object",
      "required": ["logoUrl"],
      "additionalProperties": false,
      "properties": {
        "logoUrl": {
          "type": ["string", "null"],
          "pattern": "^brand/(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(svg|png|webp)$",
          "description": "Path to the logo file, relative to config/ (for example brand/my-city/logo.svg), or null for the default icon. The key name is kept for compatibility; it is a file path, not a URL."
        }
      }
    },
    "theme": {
      "type": "object",
      "description": "The single place to change colors, font, text sizes and corner radius. Each color becomes a --color-<kebab-key> CSS variable and a Tailwind utility (bg-primary, text-on-brand, border-line, ...).",
      "required": ["colors", "dataScale", "series", "typography", "radius"],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "required": ["primary", "primarySoft", "accent", "accentSoft", "ink", "onBrand", "page", "surface", "subtle", "body", "muted", "line", "noData", "positive", "positiveFill", "negative", "warning", "scrim"],
          "additionalProperties": false,
          "properties": {
            "primary": { "$ref": "#/$defs/hex", "description": "Buttons, links, active nav, section headings." },
            "primarySoft": { "$ref": "#/$defs/hex", "description": "Tinted panels." },
            "accent": { "$ref": "#/$defs/hex", "description": "Logo tile, Explore button, favicon, highlights." },
            "accentSoft": { "$ref": "#/$defs/hex", "description": "Soft accent tint." },
            "ink": { "$ref": "#/$defs/hex", "description": "Header/footer background, headings, big numbers." },
            "onBrand": { "$ref": "#/$defs/hex", "description": "Text and icons on primary, ink, accent and positiveFill." },
            "page": { "$ref": "#/$defs/hex", "description": "Page background." },
            "surface": { "$ref": "#/$defs/hex", "description": "Cards, popovers, tooltips." },
            "subtle": { "$ref": "#/$defs/hex", "description": "Progress tracks, empty slots." },
            "body": { "$ref": "#/$defs/hex", "description": "Body text." },
            "muted": { "$ref": "#/$defs/hex", "description": "Secondary text." },
            "line": { "$ref": "#/$defs/hex", "description": "Borders and dividers." },
            "noData": { "$ref": "#/$defs/hex", "description": "Map/chart fill for missing data." },
            "positive": { "$ref": "#/$defs/hex", "description": "'Better' text and numbers." },
            "positiveFill": { "$ref": "#/$defs/hex", "description": "'Better' bars and fills." },
            "negative": { "$ref": "#/$defs/hex", "description": "'Worse' text and fills, errors." },
            "warning": { "$ref": "#/$defs/hex", "description": "Caution icons." },
            "scrim": { "$ref": "#/$defs/hex", "description": "Modal/overlay backdrop, used at 20-60% opacity." }
          }
        },
        "dataScale": { "type": "array", "description": "Map/gauge scale, worst to best (--color-scale-1..5).", "items": { "$ref": "#/$defs/hex" }, "minItems": 5, "maxItems": 5 },
        "series": { "type": "array", "description": "Compare/chart series colors in order (--color-series-1..N).", "items": { "$ref": "#/$defs/hex" }, "minItems": 3, "maxItems": 8 },
        "typography": {
          "type": "object",
          "required": ["fontPackage", "family", "fallback", "baseSize"],
          "additionalProperties": false,
          "properties": {
            "fontPackage": { "type": "string", "pattern": "^@fontsource/[a-z0-9-]+$", "description": "Font package installed in app/ (npm install <pkg>). Weights 400, 500, 600 and 700 are loaded." },
            "family": { "type": "string", "pattern": "^[A-Za-z0-9 ]+$", "description": "Family name the package registers, e.g. 'Geist'." },
            "fallback": { "type": "string", "pattern": "^[A-Za-z0-9 ,-]+$", "description": "Fallback stack, e.g. 'Helvetica, Aptos, sans-serif'." },
            "baseSize": { "type": "number", "minimum": 12, "maximum": 24, "description": "Root font size in px at the browser default of 16; emitted as a percentage so visitor font-size settings still apply. Scales every rem (text and spacing)." },
            "sizes": {
              "type": "object",
              "description": "Optional rem overrides per text step; unset steps keep the defaults.",
              "additionalProperties": false,
              "properties": {
                "3xs": { "$ref": "#/$defs/rem" },
                "2xs": { "$ref": "#/$defs/rem" },
                "xs": { "$ref": "#/$defs/rem" },
                "sm": { "$ref": "#/$defs/rem" },
                "base": { "$ref": "#/$defs/rem" },
                "lg": { "$ref": "#/$defs/rem" },
                "xl": { "$ref": "#/$defs/rem" },
                "2xl": { "$ref": "#/$defs/rem" },
                "3xl": { "$ref": "#/$defs/rem" },
                "4xl": { "$ref": "#/$defs/rem" },
                "5xl": { "$ref": "#/$defs/rem" },
                "6xl": { "$ref": "#/$defs/rem" },
                "7xl": { "$ref": "#/$defs/rem" }
              }
            }
          }
        },
        "radius": {
          "type": "object",
          "description": "Corner radii for rounded-chip, rounded-control, rounded-card and rounded-panel.",
          "required": ["chip", "control", "card", "panel"],
          "additionalProperties": false,
          "properties": {
            "chip": { "$ref": "#/$defs/length" },
            "control": { "$ref": "#/$defs/length" },
            "card": { "$ref": "#/$defs/length" },
            "panel": { "$ref": "#/$defs/length" }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "required": ["center", "zoom", "minZoom", "maxZoom"],
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "array",
          "description": "[lat, lng]",
          "prefixItems": [
            { "type": "number", "minimum": -90, "maximum": 90 },
            { "type": "number", "minimum": -180, "maximum": 180 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": { "type": "integer", "minimum": 1, "maximum": 19 },
        "minZoom": { "type": "integer", "minimum": 1, "maximum": 19 },
        "maxZoom": { "type": "integer", "minimum": 1, "maximum": 19 }
      }
    },
    "featuredZips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "zip"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "zip": { "$ref": "#/$defs/zip" }
        }
      }
    },
    "dataQualityNotes": {
      "type": "object",
      "description": "ZIPs whose residential population is too small/institutional for ACS rates; value is the note shown in the UI. ACS rates for these ZIPs are dropped by the app and excluded from scenario-model fits.",
      "propertyNames": { "pattern": "^\\d{5}$" },
      "additionalProperties": { "type": "string" }
    },
    "serviceGuideUrl": {
      "type": ["string", "null"],
      "pattern": "^https?://",
      "description": "Base URL of the city's service guide. The ZIP card links to <url>/services?zip=<ZIP>. VITE_SERVICE_GUIDE_URL at build time overrides this."
    },
    "data": {
      "type": "object",
      "required": ["indicators", "boundaries", "summary"],
      "additionalProperties": false,
      "properties": {
        "indicators": { "$ref": "#/$defs/relPath" },
        "boundaries": { "$ref": "#/$defs/relPath" },
        "summary": { "$ref": "#/$defs/relPath" }
      }
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "source"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dataAsOf": { "type": "string", "minLength": 1 },
    "pipeline": {
      "type": "object",
      "required": ["stateFips", "countyFips", "zctas", "crimeSource"],
      "additionalProperties": false,
      "properties": {
        "stateFips": { "type": "string", "pattern": "^\\d{2}$" },
        "countyFips": { "type": "string", "pattern": "^\\d{3}$" },
        "zctas": {
          "description": "Explicit ZCTA list, or null to derive it from the Census ZCTA-county relationship file.",
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/zip" } }
          ]
        },
        "crimeSource": { "enum": ["apd-austin", null], "description": "Local crime feed, or null to leave violentCrimeRate empty." }
      }
    }
  }
}
