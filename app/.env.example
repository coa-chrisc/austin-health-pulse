# Copy to app/.env.local and adjust. Vite reads these at build time.

# Base URL of the hosted Service Guide (companion app). Overrides
# `serviceGuideUrl` in the city config (config/city.config.json).
# - ZIP detail views link to <url>/services?zip=<zip>.
# - The optional lifespan estimator links to <url>/intake?event=healthspan&focus=<categories>.
# - Dev server: defaults to http://localhost:5173 when neither is set.
# - Production build: when neither is set, the Service Guide links are hidden.
# In GitHub Actions, set the repository variable SERVICE_GUIDE_URL instead.
VITE_SERVICE_GUIDE_URL=

# Set to "true" to include the individual lifespan estimator (personal-factor
# sliders, factor waterfall, service handoff). It runs in the browser and sends
# and stores nothing. Any value other than "true" means off, and the code
# default is off. The Neighborhood Equity Scenario Simulator is always included.
# Docker and partner builds also default to off. The GitHub Pages workflow
# (.github/workflows/deploy.yml) defaults it to on for the live Austin demo:
# set the repository variable ENABLE_PERSONAL_CALCULATOR=false to turn it off.
# The Census API key (CENSUS_API_KEY) is for the data pipeline only. Do not put
# it in this file.
VITE_ENABLE_PERSONAL_CALCULATOR=false
