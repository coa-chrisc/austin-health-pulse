# Copy to app/.env.local and adjust. Vite reads these at build time.

# Base URL of the hosted Austin Service Guide (companion app). The lifespan
# calculator links to <url>/intake?event=healthspan&focus=<categories>.
# - Dev server: defaults to http://localhost:5173 when unset.
# - Production build: when unset, the "Find Austin services" handoff is hidden.
# In GitHub Actions, set the repository variable SERVICE_GUIDE_URL instead.
VITE_SERVICE_GUIDE_URL=
